# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
.next/

# Environment variables
.env
.env.local
.env.*.local
# Keep .env.production tracked (no secrets, just API URL)
!apps/frontend/.env.production

# Prisma
apps/backend/prisma/migrations/*.sql.tmp

# Logs
*.log
npm-debug.log*

# Editor
.DS_Store
.vscode/
.idea/

# Vite
apps/frontend/.vite/

# TypeScript
*.tsbuildinfo
.vercel

# Test coverage & E2E artifacts
coverage/
playwright-report/
test-results/
.playwright/
apps/frontend/e2e/screenshots/

# Local deploy helper (auto-deploy Vercel actif, script obsolète)
deploy.sh

# Monorepo : app mobile (Expo, gérée indépendamment)
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/*.apk
mobile/*.aab
mobile/.env

# Graphify — graphe de connaissance GÉNÉRÉ (graph.json, GRAPH_REPORT.md, wiki/).
# Artefact dérivé du code, reconstruit par `graphify update .` : il ne se commit pas
# (il périmerait à chaque merge et gonflerait le repo).
graphify-out/
**/graphify-out/

# Config locale Claude Code — à tout niveau (racine + apps/*/.claude, etc.).
# mobile/.claude/settings.json reste suivi (déjà tracké ; .gitignore ne dé-tracke pas).
.claude/

# Rapports Playwright de la mesure de densité (harnais de dév)
apps/frontend/test-results/

# Capture vidéo du parcours de démonstration (`npm run capture:demo`).
# ⚠️ Les vidéos sont des binaires lourds et REJOUABLES : c'est le SCRIPT qui est versionné,
# pas son produit. Et `tenants-crees.txt` est le périmètre d'un ménage, pas une donnée du
# dépôt — le committer ferait croire que ces tenants existent encore.
apps/frontend/e2e/capture/tenants-crees.txt
apps/frontend/e2e/capture/videos/

# Artefacts d'éditeur et d'OS.
# ⚠️ `mobile/src/components/pos/.BarcodeScanner.tsx.swp` avait été COMMITTÉ — 16 Ko de binaire
# hérité de l'ex-dépôt `habashop-mobile` (son en-tête nomme encore l'ancien chemin). Il portait
# 9 831 octets NUL sous `src/`, là où un scan de sources ne s'attend qu'à du texte. On ferme la
# cause, pas seulement l'instance.
*.swp
*.swo
*.swn
*~
*.orig
*.rej
