# ─── API Backend ───────────────────────────
# Le client WebSocket dérive l'URL ws(s):// de VITE_API_URL.
VITE_API_URL=https://habashop-production.up.railway.app

# ─── Monitoring (optionnel) ────────────────
# Si défini (et build PROD), active Sentry côté frontend.
# Laisser vide désactive complètement Sentry.
VITE_SENTRY_DSN=

# ─── Divers ────────────────────────────────
VITE_APP_NAME=HabaShop
