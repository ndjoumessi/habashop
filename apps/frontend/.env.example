# ─── API Backend ───────────────────────────
# Le client WebSocket dérive l'URL ws(s):// de VITE_API_URL.
VITE_API_URL=https://habashop-production.up.railway.app

# ─── Monitoring (optionnel) ────────────────
# Si défini (et build PROD), active Sentry côté frontend.
# Laisser vide désactive complètement Sentry.
VITE_SENTRY_DSN=
# environment Sentry (ex. preview / production). Défaut = 'production' si vide.
VITE_ENV=
# NB : SENTRY_AUTH_TOKEN (upload des source maps au build) n'est PAS préfixé VITE_
# (build-side uniquement, jamais dans le bundle) → le mettre dans .env.local (gitignored)
# en local et comme variable de build sur Vercel.

# ─── Divers ────────────────────────────────
VITE_APP_NAME=HabaShop
