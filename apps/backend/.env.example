# ─── Base de données (OBLIGATOIRE) ─────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ─── Authentification (OBLIGATOIRE) ────────
# Générer avec : openssl rand -hex 64
# Le serveur refuse de démarrer si JWT_SECRET est absent.
JWT_SECRET=CHANGE_ME_openssl_rand_-hex_64

# ─── Serveur ───────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS ──────────────────────────────────
FRONTEND_URL=https://habashop.vercel.app

# ─── Twilio WhatsApp (optionnel) ───────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+19787546346

# ─── Anthropic IA (optionnel) ──────────────
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXX

# ─── Monitoring / alertes (optionnel) ──────
# Si défini (+ NODE_ENV=production), active Sentry backend.
SENTRY_DSN=
# Webhook Discord/Slack pour les alertes critiques (crash). Vide = désactivé.
ALERT_WEBHOOK_URL=

# ─── Email transactionnel (Resend) ────────────
# Gratuit : 3 000 emails/mois — créer un compte sur https://resend.com
# puis API Keys → Create API Key. Sans clé : les emails sont ignorés (warn).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Expéditeur. Par défaut onboarding@resend.dev (marche sans domaine vérifié).
# En prod avec domaine vérifié : noreply@votre-domaine.com
EMAIL_FROM=HabaShop <onboarding@resend.dev>

# ─── Wave Business API (optionnel) ─────────────
# Obtenir sur https://developer.wave.com
# Sans clé : les paiements Wave passent en mode sandbox (lien simulé).
WAVE_API_KEY=wave_sn_prod_XXXXXXXXXXXX
WAVE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXX

# ─── Orange Money API (optionnel) ──────────────
# Obtenir sur https://developer.orange.com
# Sans clé : les paiements Orange Money passent en mode sandbox.
ORANGE_CLIENT_ID=XXXXXXXXXXXX
ORANGE_CLIENT_SECRET=XXXXXXXXXXXX

# ─── Backend URL (pour les webhooks de paiement) ───
# Sert à construire les URLs de webhook envoyées à Wave / Orange Money.
BACKEND_URL=https://habashop-production.up.railway.app
