# ─── Base de données (OBLIGATOIRE) ─────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ─── Authentification (OBLIGATOIRE) ────────
# Générer avec : openssl rand -hex 64
# Le serveur refuse de démarrer si JWT_SECRET est absent.
JWT_SECRET=CHANGE_ME_openssl_rand_-hex_64

# ─── Serveur ───────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS ──────────────────────────────────
FRONTEND_URL=https://habashop.vercel.app

# ─── Twilio WhatsApp (optionnel) ───────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Anthropic IA (optionnel) ──────────────
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXX

# ─── Monitoring / alertes (optionnel) ──────
# Si défini (+ NODE_ENV=production), active Sentry backend.
SENTRY_DSN=
# Webhook Discord/Slack pour les alertes critiques (crash). Vide = désactivé.
ALERT_WEBHOOK_URL=
