generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("XOF")
  country   String   @default("SN")
  plan      String   @default("starter")
  vatRate   Float    @default(18)
  address   String?
  phone     String?
  email     String?
  logo      String?

  // Billing / plan lifecycle
  isActive        Boolean   @default(true)
  status          String    @default("active") // trial / active / pending_payment / suspended / cancelled (new signups set "trial" explicitly)
  trialEnds       DateTime?
  planActivatedAt DateTime?
  planRequestedAt DateTime?
  paymentMethod   String?   // wave / orange_money / mtn_money / virement / card
  paymentRef      String?
  suspendedAt     DateTime?
  suspendReason   String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // null = actif (soft delete ; suppression de boutique par l'admin)

  users          User[]
  products       Product[]
  sales          Sale[]
  customers      Customer[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  employees      Employee[]
  expenses       Expense[]
  auditLogs      AuditLog[]
  planRequests   PlanRequest[]
  pushTokens     PushToken[]

  @@index([deletedAt])
}

model PlanRequest {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  plan          String    // pro / enterprise
  period        String    // monthly / yearly
  amount        Int       // montant en XOF
  currency      String    @default("XOF")
  paymentMethod String    // wave / orange_money / mtn_money / virement / card
  paymentRef    String?
  status        String    @default("pending") // pending / approved / rejected
  notes         String?
  adminNotes    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reviewedAt    DateTime?
  reviewedBy    String?

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("CASHIER")
  twoFASecret  String?
  twoFAEnabled Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // null = actif (soft delete ; suppression de compte)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  sales          Sale[]          @relation("SaleCashier")
  purchaseOrders PurchaseOrder[] @relation("OrderCreator")
  auditLogs      AuditLog[]
  pushTokens     PushToken[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model Product {
  id                 String    @id @default(cuid())
  tenantId           String
  sku                String
  name               String
  description        String?
  category           String
  unit               String    @default("unité")
  buyPrice           Float
  sellPrice          Float
  wholesalePrice     Float?
  semiWholesalePrice Float?
  stockQty           Int       @default(0)
  stockMin           Int       @default(5)
  supplierId         String?
  barcode            String?
  taxRate            Float     @default(18)
  isActive           Boolean   @default(true)
  hasPromotion       Boolean   @default(false)
  promotionPrice     Float?
  promotionEnd       DateTime?
  emoji              String    @default("📦")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime? // null = actif (soft delete ; distinct de isActive)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  saleItems SaleItem[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, barcode])
  @@index([tenantId, deletedAt])
}

model Sale {
  id             String   @id @default(cuid())
  tenantId       String
  cashierId      String
  total          Float
  paymentMode    String   @default("cash")
  discountAmount Float    @default(0)
  discountType   String?
  discountReason String?
  clientType     String   @default("retail")
  customerId     String?
  createdAt      DateTime @default(now())

  tenant  Tenant     @relation(fields: [tenantId], references: [id])
  cashier User       @relation("SaleCashier", fields: [cashierId], references: [id])
  items   SaleItem[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, paymentMode])
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String
  qty       Int
  unitPrice Float
  total     Float

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  type          String   @default("retail")
  phone         String?
  email         String?
  address       String?
  loyaltyPoints Int      @default(0)
  totalRevenue  Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime? // null = actif (soft delete)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, totalRevenue])
  @@index([tenantId, type])
  @@index([tenantId, deletedAt])
}

model Supplier {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  categories String?
  phone      String?
  email      String?
  address    String?
  leadTime   Int      @default(3)
  rating     Int      @default(3)
  status     String   @default("Actif")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime? // null = actif (soft delete)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  tenantId    String
  ref         String
  supplierId  String
  createdById String
  status      String    @default("DRAFT")
  total       Float
  expectedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // null = actif (soft delete)

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User                @relation("OrderCreator", fields: [createdById], references: [id])
  items     PurchaseOrderItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
}

model PurchaseOrderItem {
  id          String @id @default(cuid())
  orderId     String
  productName String
  qty         Int
  unitPrice   Float
  total       Float

  order PurchaseOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Employee {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  role      String
  dept      String
  type      String    @default("CDI")
  salary    Float
  phone     String?
  email     String?
  address   String?
  photo     String?   @db.Text
  hiredAt   DateTime
  endAt     DateTime?
  isActive  Boolean   @default(true)
  perf      Int       @default(3)
  avatar    String
  color     String    @default("#6C3FD6")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // null = actif (soft delete ; suppression de compte)

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  bonuses       EmployeeBonus[]
  salaryHistory SalaryHistory[]

  @@index([tenantId])
  @@index([tenantId, dept])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
}

model EmployeeBonus {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  amount     Float
  reason     String
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
}

model SalaryHistory {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  oldSalary  Float
  newSalary  Float
  reason     String   @default("")
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
}

model Expense {
  id        String   @id @default(cuid())
  tenantId  String
  date      DateTime
  label     String
  category  String
  amountHT  Float
  vat       Float    @default(18)
  amountTTC Float
  mode      String
  recurrent Boolean  @default(false)
  status    String   @default("EN ATTENTE")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, category])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  module      String
  action      String
  description String
  ip          String?
  severity    String   @default("info")
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

model PushToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  token     String   @unique
  platform  String   @default("unknown") // ios / android / web
  deviceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
}
