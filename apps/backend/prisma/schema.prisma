generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  // Tenant INTERNE plateforme (staff super-admin SaaS), PAS une boutique cliente.
  // Exclu des listings/quotas/agrégats de la console (/api/admin/*). Défaut false.
  isPlatform Boolean @default(false)
  // Boutique de DÉMONSTRATION (comptes partagés, mot de passe public). Les actions à
  // coût externe (Anthropic, Twilio, Resend) et destructives sont refusées côté SERVEUR
  // (403 DEMO_TENANT_FORBIDDEN, cf. middleware/demoTenant.ts) — la seule protection qui
  // résiste à un curl, le mot de passe démo étant public. Défaut false.
  isDemo     Boolean @default(false)
  id         String  @id @default(cuid())
  name       String
  currency   String  @default("XOF")
  country    String  @default("SN")
  plan       String  @default("starter")
  vatRate    Float   @default(18)
  address    String?
  phone      String?
  email      String?
  logo       String?
  lang       String  @default("fr") // fr | en | es | it — langue par défaut du tenant

  // ── Identifiants légaux (pied de facture/devis — noms consommés par
  //    apps/frontend/src/utils/export.ts generateInvoice : ninea/rccm/vatNumber) ──
  ninea     String? // NINEA (SN) ou identifiant fiscal national équivalent
  rccm      String? // Registre du commerce (RC / RCCM)
  vatNumber String? // N° TVA intracommunautaire / assujetti

  // ── Paramètres POS ── (vatRate ci-dessus = TVA POS, single source of truth)
  posVatIncluded     Boolean @default(true)
  posAutoprint       Boolean @default(false)
  autoWhatsApp       Boolean @default(false)
  enableAutoWhatsApp Boolean @default(false) // envoi AUTO serveur du reçu WhatsApp après vente (Twilio)
  enableLoyalty      Boolean @default(false)
  requireCashier     Boolean @default(false)
  enableScanner      Boolean @default(false)
  priceMode          String  @default("TTC") // TTC | HT
  posDefaultFund     Float   @default(0)
  // ── Fidélité configurable par tenant (défauts = valeurs v1 ; non-rétroactif) ──
  pointsPerAmount    Int     @default(1000) // unités de devise pour 1 point (floor(montant/X))
  bronzeThreshold    Int     @default(2000) // pts : seuil Bronze → Silver
  silverThreshold    Int     @default(5000) // pts : seuil Silver → Gold
  // ── Loyalty v2 : remises % par palier (appliquées au total si client lié qualifié) ──
  bronzeDiscount     Float   @default(5.0)
  silverDiscount     Float   @default(10.0)
  goldDiscount       Float   @default(15.0)

  // ── Paramètres Notifications ──
  notifEmailSales        Boolean @default(true)
  notifEmailStock        Boolean @default(true)
  notifEmailPayroll      Boolean @default(false)
  notifSmsSales          Boolean @default(false)
  notifSmsStock          Boolean @default(true)
  notifPushAll           Boolean @default(true)
  // Idempotence du cron récap paie : 'YYYY-MM' du dernier récap envoyé (null = jamais).
  lastPayrollReportMonth String?

  // ── Catalogue public partageable ──
  slug           String? @unique // habashop.vercel.app/c/{slug}
  description    String? // tagline boutique (max 200)
  whatsappPhone  String? // numéro WhatsApp commercial (E.164) ; fallback sur phone
  ownerPhone     String? // numéro WhatsApp du gérant (E.164) — destinataire des rapports auto soir/matin ; null = pas d'envoi
  catalogVisible Boolean @default(true)

  // Billing / plan lifecycle
  isActive        Boolean   @default(true)
  status          String    @default("active") // trial / active / pending_payment / suspended / cancelled (new signups set "trial" explicitly)
  trialEnds       DateTime?
  planActivatedAt DateTime?
  planRequestedAt DateTime?
  paymentMethod   String? // wave / orange_money / mtn_money / virement / card
  paymentRef      String?
  suspendedAt     DateTime?
  suspendReason   String?
  notes           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // null = actif (soft delete ; suppression de boutique par l'admin)

  users          User[]
  products       Product[]
  sales          Sale[]
  customers      Customer[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  employees      Employee[]
  expenses       Expense[]
  auditLogs      AuditLog[]
  planRequests   PlanRequest[]
  pushTokens     PushToken[]
  goals          Goal[]
  attendance     Attendance[]
  shifts         Shift[]
  leaveRequests  LeaveRequest[]
  loyaltyTxns    LoyaltyTransaction[]
  ticketZ        TicketZ[]
  subscriptions  Subscription[]
  campaigns      Campaign[]
  userTenants    UserTenant[]
  transfersFrom  StockTransfer[]      @relation("TransferFrom")
  transfersTo    StockTransfer[]      @relation("TransferTo")

  @@index([deletedAt])
}

model PlanRequest {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  plan          String // pro / enterprise
  period        String // monthly / yearly
  amount        Int // montant en XOF
  currency      String    @default("XOF")
  paymentMethod String // wave / orange_money / mtn_money / virement / card
  paymentRef    String?
  status        String    @default("pending") // pending / approved / rejected
  notes         String?
  adminNotes    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reviewedAt    DateTime?
  reviewedBy    String?

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status])
}

model User {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  email           String    @unique
  passwordHash    String
  role            String    @default("CASHIER")
  // Admin PLATEFORME (super-admin SaaS) — orthogonal au rôle tenant. Seul ce flag
  // (jamais role==='SUPER_ADMIN') ouvre /api/admin/*. Provisionné hors API (script serveur).
  isPlatformAdmin Boolean   @default(false)
  twoFASecret     String?
  twoFAEnabled    Boolean   @default(false)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // null = actif (soft delete ; suppression de compte)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  sales          Sale[]          @relation("SaleCashier")
  purchaseOrders PurchaseOrder[] @relation("OrderCreator")
  auditLogs      AuditLog[]
  pushTokens     PushToken[]
  campaigns      Campaign[]
  userTenants    UserTenant[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

// Liaison many-to-many User ↔ Tenant (multi-boutiques v1).
// `User.tenantId` reste le tenant "principal" (rétro-compat) ; UserTenant liste
// TOUTES les boutiques accessibles + le rôle PAR boutique (peut différer du User.role).
model UserTenant {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("CASHIER")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model Product {
  id                 String    @id @default(cuid())
  tenantId           String
  sku                String
  name               String
  description        String?
  category           String
  unit               String    @default("unité")
  buyPrice           Float
  sellPrice          Float
  wholesalePrice     Float?
  semiWholesalePrice Float?
  stockQty           Int       @default(0)
  stockMin           Int       @default(5)
  supplierId         String?
  barcode            String?
  taxRate            Float     @default(18)
  isActive           Boolean   @default(true)
  hasPromotion       Boolean   @default(false)
  promotionPrice     Float?
  promotionEnd       DateTime?
  emoji              String    @default("📦")
  notes              String?
  // Paliers de prix par quantité — Format : [{ minQty: number, price: number, label?: string }]
  // null OU [] = pas de paliers, on utilise sellPrice (+ promotion si active)
  priceTiers         Json?
  // ── Instantané du jeu de tarifs PRÉCÉDENT (profondeur 1) + date du changement. ──
  // Permet au SERVEUR d'affirmer factuellement « ce prix ÉTAIT le tarif catalogue jusqu'au T »
  // quand une vente arrive avec un prix hors des tarifs courants (cf. sales.ts § qualification).
  // Écrit UNIQUEMENT côté serveur, jamais depuis le corps d'une requête (liste blanche PUT).
  // ⚠️ Profondeur 1 assumée : deux changements de prix rapprochés perdent le plus ancien —
  // la qualification retombe alors sur « non qualifiée », JAMAIS sur une fausse innocence.
  previousPricing    Json?
  pricingChangedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime? // null = actif (soft delete ; distinct de isActive)

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  saleItems         SaleItem[]
  subscriptionItems SubscriptionItem[]
  transfers         StockTransfer[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, barcode])
  @@index([tenantId, deletedAt])
}

// Transfert de stock entre boutiques (multi-boutiques v2). Validation en 2 étapes :
// SOURCE crée (pending → décrément immédiat), DESTINATION confirme (completed → incrément)
// ou l'une des deux annule (cancelled → restitution du stock source).
// `productId` = produit SOURCE ; à la confirmation, le produit destination est retrouvé
// par SKU puis code-barres, sinon copié depuis la source.
model StockTransfer {
  id           String   @id @default(cuid())
  fromTenantId String
  toTenantId   String
  productId    String
  quantity     Int
  status       String   @default("pending") // pending → completed | cancelled
  note         String?
  createdBy    String // userId (boutique source)
  confirmedBy  String? // userId (boutique destination)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fromTenant Tenant  @relation("TransferFrom", fields: [fromTenantId], references: [id])
  toTenant   Tenant  @relation("TransferTo", fields: [toTenantId], references: [id])
  product    Product @relation(fields: [productId], references: [id])

  @@index([fromTenantId, status])
  @@index([toTenantId, status])
}

model Sale {
  id             String   @id @default(cuid())
  tenantId       String
  cashierId      String
  total          Float
  paymentMode    String   @default("cash")
  discountAmount Float    @default(0)
  discountType   String?
  discountReason String?
  clientType     String   @default("retail")
  customerId     String?
  createdAt      DateTime @default(now())

  // ── Remboursement (TOTAL uniquement ; champs additifs/nullables) ──
  status       String    @default("completed") // completed | refunded
  refundedAt   DateTime?
  refundedBy   String? // userId du manager/admin ayant remboursé (audit = source détaillée)
  refundReason String?
  restocked    Boolean? // null tant que non remboursé ; true = articles remis en stock, false = non

  // ── Idempotence (résilience réseau) : clé envoyée par le client par tentative ──
  // Nullable = rétro-compat (ventes existantes / clients sans clé). Unicité scopée tenant.
  idempotencyKey String?

  // ── Facture PDF : numéro attribué à la 1ʳᵉ demande puis figé (FAC-{YYYY}-{NNNNN}). ──
  invoiceNumber String?

  // ── Loyalty v2 : remise fidélité appliquée au total (0 si pas de client/palier). ──
  loyaltyDiscount Float? @default(0)

  // ── Intégrité prix : au moins une ligne a un prix soumis ≠ prix catalogue serveur.
  //    Flag d'AUDIT (filtre `?priceDivergence=true` dans l'historique). Le détail vit sur SaleItem. ──
  priceDivergence Boolean? @default(false)

  // ── Paiement mixte (split, max 2 méthodes/vente) : ventilation du total par mode. ──
  // Toujours renseignés sur les NOUVELLES ventes (0 si mode non utilisé) ; NULL sur les
  // ventes antérieures → fallback paymentMode via COALESCE dans les agrégats (Ticket Z).
  cashAmount        Float?
  mobileMoneyAmount Float?
  cardAmount        Float?

  // Référence MTN MoMo (UUID retourné par requesttopay) — traçabilité / réconciliation.
  mtnMomoReference String?

  // Référence Campay (Orange Money / cartes Cameroun) — traçabilité / réconciliation.
  campayReference String?

  // Référence PayDunya (token facture — Wave/Orange Money Sénégal & UEMOA) — réconciliation.
  paydunyaReference String?

  tenant  Tenant     @relation(fields: [tenantId], references: [id])
  cashier User       @relation("SaleCashier", fields: [cashierId], references: [id])
  items   SaleItem[]

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, paymentMode])
  @@index([tenantId, status])
}

// Ticket Z — clôture journalière de caisse (1 par jour/tenant, regénérable = upsert).
model TicketZ {
  id                  String   @id @default(cuid())
  tenantId            String
  date                DateTime // date seule (minuit UTC)
  caVentes            Float // CA brut des ventes non remboursées
  nbVentes            Int
  totalRemboursements Float // somme des ventes remboursées (refunded)
  caNets              Float // caVentes - totalRemboursements
  cashAmount          Float
  mobileMoneyAmount   Float // wave + orange + mtn + mobile
  cardAmount          Float
  panierMoyen         Float
  nbClients           Int // clients distincts (customerId non null)
  generatedBy         String // userId
  generatedAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date])
  @@index([tenantId, date])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  qty       Int
  unitPrice Float
  total     Float
  tierLabel String? // label du palier appliqué au moment de la vente (null = prix de base)

  // ── Intégrité prix (ticket) : TRACE d'une divergence entre le prix SOUMIS par le client
  //    et le prix CATALOGUE serveur (détail). Renseignés SEULEMENT en cas de divergence
  //    (le prix soumis ne correspond à aucun point de tarif serveur) ; null sinon. ──
  submittedPrice Float? // prix unitaire envoyé par le client
  catalogPrice   Float? // prix unitaire autoritaire serveur (référence détail)
  // QUALIFICATION de la divergence, serveur-autoritaire (aucune donnée client) : non-null =
  // le prix soumis appartenait au jeu de tarifs PRÉCÉDENT du produit, changé à cette date,
  // et le changement est assez récent pour qu'un catalogue en cache POS l'explique.
  // ⚠️ Ce n'est PAS une affirmation d'innocence — c'est un fait daté à présenter à l'auditeur.
  // null = divergence NON qualifiée (comportement historique, à regarder).
  staleCatalogAt DateTime?
  // true = le montant SOUMIS a été facturé tel quel (rejeu hors-ligne honoré : `offlineReplay`
  // ET `staleCatalogAt` non-null). false = ligne re-tarifée au prix serveur, ou aucune divergence.
  // ⚠️ Sans cette colonne, l'audit ne peut pas distinguer « honoré » de « re-tarifé » autrement
  //    qu'en recomparant des montants — et l'argent a bougé, donc la ligne doit être VÉRIFIÉE.
  pricingHonored Boolean   @default(false)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Customer {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  type          String    @default("retail")
  phone         String?
  email         String?
  address       String?
  loyaltyPoints Int       @default(0)
  totalRevenue  Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // null = actif (soft delete)

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  loyaltyTxns   LoyaltyTransaction[]
  subscriptions Subscription[]

  @@index([tenantId])
  @@index([tenantId, totalRevenue])
  @@index([tenantId, type])
  @@index([tenantId, deletedAt])
}

// Historique des mouvements de points fidélité (gain à la vente / retrait au remboursement).
// points = delta SIGNÉ appliqué au solde (earn: +N, reverse: −N) ; type explicite la direction.
model LoyaltyTransaction {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  saleId     String? // vente d'origine (null pour ajustement manuel)
  points     Int // signé : +gain / −retrait
  type       String // 'earn' | 'reverse'
  reason     String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, customerId])
  @@index([saleId])
}

model Supplier {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  categories String?
  phone      String?
  email      String?
  address    String?
  leadTime   Int       @default(3)
  rating     Int       @default(3)
  status     String    @default("Actif")
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime? // null = actif (soft delete)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  tenantId    String
  ref         String
  supplierId  String
  createdById String
  status      String    @default("DRAFT")
  total       Float
  expectedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // null = actif (soft delete)

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User                @relation("OrderCreator", fields: [createdById], references: [id])
  items     PurchaseOrderItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
}

model PurchaseOrderItem {
  id          String @id @default(cuid())
  orderId     String
  productName String
  qty         Int
  unitPrice   Float
  total       Float

  order PurchaseOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Employee {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  role      String
  dept      String
  type      String    @default("CDI")
  salary    Float
  phone     String?
  email     String?
  address   String?
  photo     String?   @db.Text
  hiredAt   DateTime
  endAt     DateTime?
  isActive  Boolean   @default(true)
  perf      Int       @default(3)
  avatar    String
  color     String    @default("#6C3FD6")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // null = actif (soft delete ; suppression de compte)

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  bonuses       EmployeeBonus[]
  salaryHistory SalaryHistory[]
  payrolls      Payroll[]
  attendance    Attendance[]
  shifts        Shift[]
  leaveRequests LeaveRequest[]

  @@index([tenantId])
  @@index([tenantId, dept])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
}

model EmployeeBonus {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  amount     Float
  reason     String
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
}

model SalaryHistory {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  oldSalary  Float
  newSalary  Float
  reason     String   @default("")
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
}

// Bulletin de paie d'un employé pour un mois donné.
//
// ⚠️ INSTANTANÉ GELÉ, et c'est l'INVERSE de la règle Abonnements. Un abonnement ne stocke
// aucun total (« au tarif du jour ») ; un bulletin de paie, lui, FIGE ses montants au moment
// de la génération. Une augmentation en août ne doit pas réécrire ce qui a été versé en juin —
// sinon la paie passée devient irrécupérable et l'export comptable ment rétroactivement.
// Les montants ci-dessous sont donc une COPIE, jamais une jointure vers `Employee.salary`.
//
// `month` = "YYYY-MM" (ISO). ⚠️ PAS le libellé français de l'écran (« Juillet 2026 ») : une
// clé de base ne peut pas dépendre de la langue d'affichage. La conversion vit côté front
// (`monthKey`/`monthLabel`) ; le serveur ne connaît que l'ISO.
//
// `status` = String (convention du projet : pas d'enum Prisma) — EN ATTENTE|GÉNÉRÉ|PAYÉ|SUSPENDU,
// validé par zod au niveau route.
model Payroll {
  id         String    @id @default(cuid())
  tenantId   String
  employeeId String
  month      String // "YYYY-MM"
  status     String    @default("GÉNÉRÉ")
  paidAt     DateTime?

  // ── Instantané FIGÉ à la génération (jamais recalculé) ──
  employeeName String // le nom AUSSI : un employé renommé ne réécrit pas sa paie passée
  role         String @default("")
  baseSalary   Float
  bonus        Float  @default(0)
  overtime     Float  @default(0)
  deductions   Float  @default(0)
  absences     Int    @default(0)
  net          Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Idempotence de la génération : rejouer « Générer » sur le même mois ne duplique pas.
  @@unique([tenantId, employeeId, month])
  @@index([tenantId])
  @@index([tenantId, month])
  @@index([employeeId])
}

// Présence quotidienne d'un employé. `status` = String (convention du projet : pas d'enum
// Prisma ; valeurs PRESENT|LATE|ABSENT|HALF|LEAVE|REST validées au niveau route → 400 sinon).
// `date` = String "YYYY-MM-DD" (date-only) : clé d'unicité jour/employé sans dérive de
// fuseau, miroir de la clé localStorage frontend `${empId}_${date}` (compat Phase 2).
model Attendance {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  date       String // "YYYY-MM-DD"
  status     String // PRESENT | LATE | ABSENT | LEAVE | REST
  arriveTime String? // "HH:MM"
  departTime String? // "HH:MM"
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
  @@index([employeeId])
}

// Shift planning DATÉ (Phase 5). Le localStorage frontend stockait UN type par (empId, index
// jour-de-semaine 0-6) → ici on passe à une vraie DATE. `shiftTypeKey` = clé SHIFT_TYPES
// frontend (morning|afternoon|full|night|rest|leave). `@@unique([tenantId,employeeId,date,
// shiftTypeKey])` = **plusieurs shifts/jour/employé** (ex. matin + soir), mais pas 2× le même
// type le même jour. Les horaires/label/couleur viennent de SHIFT_TYPES côté front (overrides ok).
model Shift {
  id           String   @id @default(cuid())
  tenantId     String
  employeeId   String
  date         String // "YYYY-MM-DD"
  shiftTypeKey String // morning | afternoon | full | night | rest | leave
  startTime    String? // "HH:MM"
  endTime      String? // "HH:MM"
  label        String?
  color        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, date, shiftTypeKey])
  @@index([tenantId, date])
  @@index([employeeId])
}

// Demande de congé persistée (Phase 5). `status` = String PENDING|APPROVED|REFUSED (validé
// route → 400). Dates String "YYYY-MM-DD". Approbation transactionnelle (route dédiée) :
// status→APPROVED + approvedBy/approvedAt + génère Shifts Congé + Attendance LEAVE par jour.
model LeaveRequest {
  id         String    @id @default(cuid())
  tenantId   String
  employeeId String
  startDate  String // "YYYY-MM-DD"
  endDate    String // "YYYY-MM-DD"
  leaveType  String // ex. "Congé annuel", "Congé maladie"… (valeur libre, comme le front)
  status     String    @default("PENDING") // PENDING | APPROVED | REFUSED
  reason     String?
  approvedBy String? // userId (JWT) de l'approbateur
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
}

model Expense {
  id        String   @id @default(cuid())
  tenantId  String
  date      DateTime
  label     String
  category  String
  amountHT  Float
  vat       Float    @default(18)
  amountTTC Float
  mode      String
  recurrent Boolean  @default(false)
  status    String   @default("EN ATTENTE")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, category])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  module      String
  action      String
  description String
  ip          String?
  severity    String   @default("info")
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

/// Audit d'échelle UTILISATEUR — hors boutique. Un changement de mot de passe
/// n'appartient à aucune boutique : le tenant-scoper le rendrait dépendant du
/// contexte de session (boutique active pour un mono-boutique, null pour un
/// multi-boutiques n'ayant pas encore choisi) — le même événement enregistré à
/// deux échelles selon qui le déclenche.
///
/// ⚠️ VOLONTAIREMENT SANS relation Prisma vers `User` : un audit de sécurité doit
/// SURVIVRE à ce qu'il audite. Avec un CASCADE, un attaquant qui compromet un
/// compte, change le mot de passe puis supprime le compte effacerait sa propre
/// trace ; avec un RESTRICT, la suppression de compte deviendrait impossible.
/// `userId` est donc une VALEUR HISTORIQUE sans contrainte, et les instantanés
/// email/nom gardent la ligne lisible une fois le compte parti — un `userId`
/// orphelin ne dit plus rien à lui seul.
///
/// ⚠️ Hors de la liste des modèles scopés de l'extension Prisma (`src/db.ts`) :
/// cette table n'a pas de `tenantId` et ne doit jamais en recevoir un.
model UserAuditLog {
  id                String   @id @default(cuid())
  userId            String
  userEmailSnapshot String
  userNameSnapshot  String
  action            String
  description       String
  ip                String?
  severity          String   @default("info")
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model PushToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  token     String   @unique
  platform  String   @default("unknown") // ios / android / web
  deviceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
}

model Goal {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  label        String
  target       Float
  current      Float     @default(0)
  unit         String    @default("")
  period       String    @default("month") // month | week | year
  color        String    @default("#6C47FF")
  icon         String    @default("🎯")
  category     String    @default("revenue") // revenue | stock | customers | team
  linkedMetric String? // salesMonth | transactionsMonth | avgBasket | null
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model Subscription {
  id         String    @id @default(cuid())
  tenantId   String
  customerId String
  name       String
  dayOfWeek  Int // 0=Dim 1=Lun 2=Mar 3=Mer 4=Jeu 5=Ven 6=Sam
  // Première livraison. NULL = pas de date de début (comportement historique : dû dès le
  // prochain dayOfWeek). Filtré par GET /api/subscriptions/due — cf. la migration.
  startDate  DateTime?
  status     String    @default("active") // active | paused | cancelled
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  customer Customer           @relation(fields: [customerId], references: [id])
  items    SubscriptionItem[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, dayOfWeek])
}

model SubscriptionItem {
  id             String @id @default(cuid())
  subscriptionId String
  productId      String
  quantity       Int    @default(1)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([subscriptionId])
}

// Campagnes WhatsApp marketing (segment-based) — 1/heure/tenant via Redis.
model Campaign {
  id             String   @id @default(cuid())
  tenantId       String
  sentBy         String
  message        String   @db.Text
  segment        String   @default("all") // all | bronze | silver | gold | wholesale | retail
  recipientCount Int
  sentCount      Int
  failedCount    Int      @default(0)
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [sentBy], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
}
