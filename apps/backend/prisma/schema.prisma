generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("XOF")
  country   String   @default("SN")
  plan      String   @default("starter")
  vatRate   Float    @default(18)
  address   String?
  phone     String?
  email     String?
  logo      String?
  lang      String   @default("fr") // fr | en | es | it — langue par défaut du tenant

  // ── Paramètres POS ── (vatRate ci-dessus = TVA POS, single source of truth)
  posVatIncluded    Boolean  @default(true)
  posAutoprint      Boolean  @default(false)
  autoWhatsApp      Boolean  @default(false)
  enableAutoWhatsApp Boolean @default(false) // envoi AUTO serveur du reçu WhatsApp après vente (Twilio)
  enableLoyalty     Boolean  @default(false)
  requireCashier    Boolean  @default(false)
  enableScanner     Boolean  @default(false)
  priceMode         String   @default("TTC") // TTC | HT
  posDefaultFund    Float    @default(0)
  // ── Fidélité configurable par tenant (défauts = valeurs v1 ; non-rétroactif) ──
  pointsPerAmount   Int      @default(1000) // unités de devise pour 1 point (floor(montant/X))
  bronzeThreshold   Int      @default(2000) // pts : seuil Bronze → Silver
  silverThreshold   Int      @default(5000) // pts : seuil Silver → Gold
  // ── Loyalty v2 : remises % par palier (appliquées au total si client lié qualifié) ──
  bronzeDiscount    Float    @default(5.0)
  silverDiscount    Float    @default(10.0)
  goldDiscount      Float    @default(15.0)

  // ── Paramètres Notifications ──
  notifEmailSales   Boolean  @default(true)
  notifEmailStock   Boolean  @default(true)
  notifEmailPayroll Boolean  @default(false)
  notifSmsSales     Boolean  @default(false)
  notifSmsStock     Boolean  @default(true)
  notifPushAll      Boolean  @default(true)
  // Idempotence du cron récap paie : 'YYYY-MM' du dernier récap envoyé (null = jamais).
  lastPayrollReportMonth String?

  // ── Catalogue public partageable ──
  slug             String?  @unique // habashop.vercel.app/c/{slug}
  description      String?         // tagline boutique (max 200)
  whatsappPhone    String?         // numéro WhatsApp commercial (E.164) ; fallback sur phone
  ownerPhone       String?         // numéro WhatsApp du gérant (E.164) — destinataire des rapports auto soir/matin ; null = pas d'envoi
  catalogVisible   Boolean  @default(true)

  // Billing / plan lifecycle
  isActive        Boolean   @default(true)
  status          String    @default("active") // trial / active / pending_payment / suspended / cancelled (new signups set "trial" explicitly)
  trialEnds       DateTime?
  planActivatedAt DateTime?
  planRequestedAt DateTime?
  paymentMethod   String?   // wave / orange_money / mtn_money / virement / card
  paymentRef      String?
  suspendedAt     DateTime?
  suspendReason   String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // null = actif (soft delete ; suppression de boutique par l'admin)

  users          User[]
  products       Product[]
  sales          Sale[]
  customers      Customer[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  employees      Employee[]
  expenses       Expense[]
  auditLogs      AuditLog[]
  planRequests   PlanRequest[]
  pushTokens     PushToken[]
  goals          Goal[]
  attendance     Attendance[]
  shifts         Shift[]
  leaveRequests  LeaveRequest[]
  loyaltyTxns    LoyaltyTransaction[]
  ticketZ        TicketZ[]

  @@index([deletedAt])
}

model PlanRequest {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  plan          String    // pro / enterprise
  period        String    // monthly / yearly
  amount        Int       // montant en XOF
  currency      String    @default("XOF")
  paymentMethod String    // wave / orange_money / mtn_money / virement / card
  paymentRef    String?
  status        String    @default("pending") // pending / approved / rejected
  notes         String?
  adminNotes    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reviewedAt    DateTime?
  reviewedBy    String?

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("CASHIER")
  twoFASecret  String?
  twoFAEnabled Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // null = actif (soft delete ; suppression de compte)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  sales          Sale[]          @relation("SaleCashier")
  purchaseOrders PurchaseOrder[] @relation("OrderCreator")
  auditLogs      AuditLog[]
  pushTokens     PushToken[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model Product {
  id                 String    @id @default(cuid())
  tenantId           String
  sku                String
  name               String
  description        String?
  category           String
  unit               String    @default("unité")
  buyPrice           Float
  sellPrice          Float
  wholesalePrice     Float?
  semiWholesalePrice Float?
  stockQty           Int       @default(0)
  stockMin           Int       @default(5)
  supplierId         String?
  barcode            String?
  taxRate            Float     @default(18)
  isActive           Boolean   @default(true)
  hasPromotion       Boolean   @default(false)
  promotionPrice     Float?
  promotionEnd       DateTime?
  emoji              String    @default("📦")
  notes              String?
  // Paliers de prix par quantité — Format : [{ minQty: number, price: number, label?: string }]
  // null OU [] = pas de paliers, on utilise sellPrice (+ promotion si active)
  priceTiers         Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime? // null = actif (soft delete ; distinct de isActive)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  saleItems SaleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, barcode])
  @@index([tenantId, deletedAt])
}

model Sale {
  id             String   @id @default(cuid())
  tenantId       String
  cashierId      String
  total          Float
  paymentMode    String   @default("cash")
  discountAmount Float    @default(0)
  discountType   String?
  discountReason String?
  clientType     String   @default("retail")
  customerId     String?
  createdAt      DateTime @default(now())

  // ── Remboursement (TOTAL uniquement ; champs additifs/nullables) ──
  status         String    @default("completed") // completed | refunded
  refundedAt     DateTime?
  refundedBy     String?   // userId du manager/admin ayant remboursé (audit = source détaillée)
  refundReason   String?
  restocked      Boolean?  // null tant que non remboursé ; true = articles remis en stock, false = non

  // ── Idempotence (résilience réseau) : clé envoyée par le client par tentative ──
  // Nullable = rétro-compat (ventes existantes / clients sans clé). Unicité scopée tenant.
  idempotencyKey String?

  // ── Facture PDF : numéro attribué à la 1ʳᵉ demande puis figé (FAC-{YYYY}-{NNNNN}). ──
  invoiceNumber  String?

  // ── Loyalty v2 : remise fidélité appliquée au total (0 si pas de client/palier). ──
  loyaltyDiscount   Float?   @default(0)

  // ── Paiement mixte (split, max 2 méthodes/vente) : ventilation du total par mode. ──
  // Toujours renseignés sur les NOUVELLES ventes (0 si mode non utilisé) ; NULL sur les
  // ventes antérieures → fallback paymentMode via COALESCE dans les agrégats (Ticket Z).
  cashAmount        Float?
  mobileMoneyAmount Float?
  cardAmount        Float?

  // Référence MTN MoMo (UUID retourné par requesttopay) — traçabilité / réconciliation.
  mtnMomoReference  String?

  tenant  Tenant     @relation(fields: [tenantId], references: [id])
  cashier User       @relation("SaleCashier", fields: [cashierId], references: [id])
  items   SaleItem[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, paymentMode])
  @@index([tenantId, status])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, invoiceNumber])
}

// Ticket Z — clôture journalière de caisse (1 par jour/tenant, regénérable = upsert).
model TicketZ {
  id                  String   @id @default(cuid())
  tenantId            String
  date                DateTime // date seule (minuit UTC)
  caVentes            Float    // CA brut des ventes non remboursées
  nbVentes            Int
  totalRemboursements Float    // somme des ventes remboursées (refunded)
  caNets              Float    // caVentes - totalRemboursements
  cashAmount          Float
  mobileMoneyAmount   Float    // wave + orange + mtn + mobile
  cardAmount          Float
  panierMoyen         Float
  nbClients           Int      // clients distincts (customerId non null)
  generatedBy         String   // userId
  generatedAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date])
  @@index([tenantId, date])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  qty       Int
  unitPrice Float
  total     Float
  tierLabel String? // label du palier appliqué au moment de la vente (null = prix de base)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  type          String   @default("retail")
  phone         String?
  email         String?
  address       String?
  loyaltyPoints Int      @default(0)
  totalRevenue  Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime? // null = actif (soft delete)

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  loyaltyTxns LoyaltyTransaction[]

  @@index([tenantId])
  @@index([tenantId, totalRevenue])
  @@index([tenantId, type])
  @@index([tenantId, deletedAt])
}

// Historique des mouvements de points fidélité (gain à la vente / retrait au remboursement).
// points = delta SIGNÉ appliqué au solde (earn: +N, reverse: −N) ; type explicite la direction.
model LoyaltyTransaction {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  saleId     String?  // vente d'origine (null pour ajustement manuel)
  points     Int      // signé : +gain / −retrait
  type       String   // 'earn' | 'reverse'
  reason     String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, customerId])
  @@index([saleId])
}

model Supplier {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  categories String?
  phone      String?
  email      String?
  address    String?
  leadTime   Int      @default(3)
  rating     Int      @default(3)
  status     String   @default("Actif")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime? // null = actif (soft delete)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  tenantId    String
  ref         String
  supplierId  String
  createdById String
  status      String    @default("DRAFT")
  total       Float
  expectedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // null = actif (soft delete)

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User                @relation("OrderCreator", fields: [createdById], references: [id])
  items     PurchaseOrderItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
}

model PurchaseOrderItem {
  id          String @id @default(cuid())
  orderId     String
  productName String
  qty         Int
  unitPrice   Float
  total       Float

  order PurchaseOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Employee {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  role      String
  dept      String
  type      String    @default("CDI")
  salary    Float
  phone     String?
  email     String?
  address   String?
  photo     String?   @db.Text
  hiredAt   DateTime
  endAt     DateTime?
  isActive  Boolean   @default(true)
  perf      Int       @default(3)
  avatar    String
  color     String    @default("#6C3FD6")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // null = actif (soft delete ; suppression de compte)

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  bonuses       EmployeeBonus[]
  salaryHistory SalaryHistory[]
  attendance    Attendance[]
  shifts        Shift[]
  leaveRequests LeaveRequest[]

  @@index([tenantId])
  @@index([tenantId, dept])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
}

model EmployeeBonus {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  amount     Float
  reason     String
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
}

model SalaryHistory {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  oldSalary  Float
  newSalary  Float
  reason     String   @default("")
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
}

// Présence quotidienne d'un employé. `status` = String (convention du projet : pas d'enum
// Prisma ; valeurs PRESENT|LATE|ABSENT|HALF|LEAVE|REST validées au niveau route → 400 sinon).
// `date` = String "YYYY-MM-DD" (date-only) : clé d'unicité jour/employé sans dérive de
// fuseau, miroir de la clé localStorage frontend `${empId}_${date}` (compat Phase 2).
model Attendance {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  date       String   // "YYYY-MM-DD"
  status     String   // PRESENT | LATE | ABSENT | LEAVE | REST
  arriveTime String?  // "HH:MM"
  departTime String?  // "HH:MM"
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
  @@index([employeeId])
}

// Shift planning DATÉ (Phase 5). Le localStorage frontend stockait UN type par (empId, index
// jour-de-semaine 0-6) → ici on passe à une vraie DATE. `shiftTypeKey` = clé SHIFT_TYPES
// frontend (morning|afternoon|full|night|rest|leave). `@@unique([tenantId,employeeId,date,
// shiftTypeKey])` = **plusieurs shifts/jour/employé** (ex. matin + soir), mais pas 2× le même
// type le même jour. Les horaires/label/couleur viennent de SHIFT_TYPES côté front (overrides ok).
model Shift {
  id           String   @id @default(cuid())
  tenantId     String
  employeeId   String
  date         String   // "YYYY-MM-DD"
  shiftTypeKey String   // morning | afternoon | full | night | rest | leave
  startTime    String?  // "HH:MM"
  endTime      String?  // "HH:MM"
  label        String?
  color        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, date, shiftTypeKey])
  @@index([tenantId, date])
  @@index([employeeId])
}

// Demande de congé persistée (Phase 5). `status` = String PENDING|APPROVED|REFUSED (validé
// route → 400). Dates String "YYYY-MM-DD". Approbation transactionnelle (route dédiée) :
// status→APPROVED + approvedBy/approvedAt + génère Shifts Congé + Attendance LEAVE par jour.
model LeaveRequest {
  id         String    @id @default(cuid())
  tenantId   String
  employeeId String
  startDate  String    // "YYYY-MM-DD"
  endDate    String    // "YYYY-MM-DD"
  leaveType  String    // ex. "Congé annuel", "Congé maladie"… (valeur libre, comme le front)
  status     String    @default("PENDING") // PENDING | APPROVED | REFUSED
  reason     String?
  approvedBy String?   // userId (JWT) de l'approbateur
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
}

model Expense {
  id        String   @id @default(cuid())
  tenantId  String
  date      DateTime
  label     String
  category  String
  amountHT  Float
  vat       Float    @default(18)
  amountTTC Float
  mode      String
  recurrent Boolean  @default(false)
  status    String   @default("EN ATTENTE")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, category])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  module      String
  action      String
  description String
  ip          String?
  severity    String   @default("info")
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

model PushToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  token     String   @unique
  platform  String   @default("unknown") // ios / android / web
  deviceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
}

model Goal {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  label         String
  target        Float
  current       Float    @default(0)
  unit          String   @default("")
  period        String   @default("month") // month | week | year
  color         String   @default("#6C47FF")
  icon          String   @default("🎯")
  category      String   @default("revenue") // revenue | stock | customers | team
  linkedMetric  String?  // salesMonth | transactionsMonth | avgBasket | null
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}
