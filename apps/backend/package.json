{
  "name": "@habashop/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node scripts/gen-version.mjs",
    "build": "tsc",
    "smoke:version": "node scripts/smoke-deployed-version.mjs",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts --max-warnings 328",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^5.16.1",
    "@sentry/node": "^10.53.1",
    "bcryptjs": "^2.4.3",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^6.1.0",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "resend": "^6.12.3",
    "twilio": "^6.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.11",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.5",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^8.57.0",
    "prisma": "^5.16.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8"
  }
}
