EXPO_PUBLIC_API_URL=https://habashop-production.up.railway.app

# URL publique de l'app WEB — imprimée sur les tickets CLIENTS (reçu, ticket WhatsApp) et
# citée dans Réglages. Miroir mobile de FRONTEND_URL (backend) et VITE_APP_URL (front).
# Absente = repli sur l'hôte actuel (src/lib/appUrl.ts) → comportement inchangé.
# ⚠️ Ce fichier .env n'atteint PAS le builder : `.env` est gitignoré et eas.json déclare
# `"environment": preview|production`. Pour que la variable agisse sur un build ou un OTA,
# la poser côté EAS : `eas env:create --environment preview --name EXPO_PUBLIC_APP_URL`.
EXPO_PUBLIC_APP_URL=

# Sentry (optionnel) — DSN public du projet. Vide = crash reporter désactivé.
# Actif uniquement en dev/preview/production build (jamais en Expo Go).
EXPO_PUBLIC_SENTRY_DSN=

# Raccourci de connexion DÉMO (5 boutons préremplissant les comptes de demo-tenant-001).
# `1` = affiché · toute autre valeur ou ABSENTE = masqué. ⚠️ Défaut ÉTEINT, délibérément :
# ces boutons partaient auparavant dans CHAQUE build, y compris celui du store.
# Miroir mobile de VITE_DEMO_MODE côté web. Pour un build/OTA de démonstration :
# `eas env:create --environment preview --name EXPO_PUBLIC_DEMO_MODE --value 1`
EXPO_PUBLIC_DEMO_MODE=
